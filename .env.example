# Variables opcionales. NASA POWER y USDA Soil Data Access no piden clave.
# Copiar a .env solo si hace falta cambiar algo; .env no se versiona.
# El código no lee .env solo: usar  uvicorn rotaciones.api:app --env-file .env

# Carpeta de la caché de NASA POWER (por defecto ./cache)
ROTACIONES_CACHE_DIR=cache

# Segundos de espera por cada petición a NASA POWER (por defecto 60)
NASA_POWER_TIMEOUT=60
